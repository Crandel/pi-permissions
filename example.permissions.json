{
	"rules": [
		{
			"action": "deny",
			"match": {
				"tool": "bash",
				"params": {
					"command": "rm\\s+-rf"
				}
			},
			"message": "Block rm -rf",
			"priority": 10
		},
		{
			"action": "deny",
			"match": {
				"tool": "*",
				"paths": ["/home/cadmon/*", "/boot/*", "/etc/*"]
			},
			"message": "Forbid access for sensitive paths",
			"priority": 10
		},
		{
			"action": "allow",
			"match": {
				"tool": "read",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow reading projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "bash",
				"pathParam": "cwd",
				"params": {
					"command": "grep"
				},
				"paths": ["/data/work/projects"]
			},
			"message": "Allow greping in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "bash",
				"pathParam": "cwd",
				"params": {
					"command": "find"
				},
				"paths": ["/data/work/projects"]
			},
			"message": "Allow finding in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "ast_grep_search",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow greping in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "symbol_search",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow searching in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "read_symbol",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow reading in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "read_enclosing",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow reading in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "lsp_navigation",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow navigation in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "lsp_diagnostics",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow diagnostics in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "module_report",
				"paths": ["/data/work/projects"]
			},
			"message": "Allow module reports in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "bash",
				"pathParam": "cwd",
				"params": {
					"command": "openspec"
				},
				"paths": ["/data/work/projects"]
			},
			"message": "Allow openspec in projects files",
			"priority": 5
		},
		{
			"action": "allow",
			"match": {
				"tool": "bash",
				"pathParam": "cwd",
				"params": {
					"command": "rtk"
				},
				"paths": ["/data/work/projects"]
			},
			"message": "Allow rtk in projects files",
			"priority": 5
		},
		{
			"action": "ask",
			"match": { "tool": "*" },
			"message": "No specific rule matched — confirm this action"
		}
	],
	"debug": true
}
